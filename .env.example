OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Transport: "mock" runs the whole demo in-process with no Discord/Switch server.
# Set to "switch" once a real Switch server + Discord connection exist, and fill in the vars below.
TRANSPORT=mock

SWITCH_BASE_URL=http://localhost:8000
SWITCH_WS_BASE_URL=ws://localhost:8000
SWITCH_REGISTRATION_TOKEN=
SWITCH_AGENT_NAME=blocker-bot
SWITCH_ROOM_ID=
